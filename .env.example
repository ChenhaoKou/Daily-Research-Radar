SYNC_DAYS_BACK="1095"
SYNC_LIMIT_PER_SOURCE="30"
# full: re-fetch every term within SYNC_DAYS_BACK and (re)build from scratch.
# incremental: only fetch SYNC_INCREMENTAL_DAYS_BACK days and merge into the
# previous public/data/papers.json. Falls back to "full" if no previous file.
SYNC_MODE="full"
SYNC_INCREMENTAL_DAYS_BACK="7"
# Per-topic ceiling applied after dedup. With ~50 keywords per topic the raw
# count can easily exceed 5k papers per topic; the dashboard JSON gets too big
# to ship over GitHub Pages above ~3-4k papers total.
MAX_PAPERS_PER_TOPIC="400"
REPOSITORY_CHECK_LIMIT="600"
REPOSITORY_CHECK_CONCURRENCY="4"
# Optional. Cap the number of unique terms fetched per run (0 = no cap). Useful for smoke tests.
SYNC_TERM_LIMIT="0"
# Optional. Set to "1" to re-enable Papers with Code and ACL Anthology adapters
# (currently broken upstream and disabled by default).
INCLUDE_OPTIONAL_SOURCES=""
NEXT_PUBLIC_BASE_PATH=""

# Optional. Increases GitHub Search API rate limits for repository detection.
GITHUB_TOKEN=""

# Optional. Enables the IEEE Xplore adapter.
IEEE_API_KEY=""

# Optional. Removes the 429 wall on Semantic Scholar. Get one at
# https://www.semanticscholar.org/product/api#api-key
SEMANTIC_SCHOLAR_API_KEY=""
